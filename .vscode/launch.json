{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Launch (console)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Build",
      "program": "${workspaceFolder}/src/JUS.CLI/bin/Debug/net10.0/JUS.CLI.dll",
      "args": [
        "jus",
        "game",
        "import",
        "--game",
        "${workspaceFolder}/src/JUS.CLI/bin/Debug/net10.0/jump_jp.nds",
        "--input",
        "${workspaceFolder}/src/JUS.CLI/bin/Debug/net10.0/01-refactor-ekona/menus/",
        "--output",
        "${workspaceFolder}/src/JUS.CLI/bin/Debug/net10.0/01-refactor-ekona/out/"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "internalConsole"
    },
    {
      "name": ".NET Attach",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ]
}
